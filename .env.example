# ==============================================================================
# GENKIT AI v6.1 PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Server
APP_NAME=Genkit AI Assistant
APP_VERSION=6.1.0
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=replace-with-a-secure-32-byte-secret-key-for-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,https://genkit.in,https://www.genkit.in

# Frontend API URL
VITE_API_URL=http://localhost:8000

# LLM Architecture & Paths (Synchronized with config_v6.json & bpe_tokenizer_v5.json)
MODEL_DIR=genkit-model
MODEL_CHECKPOINT=model_v6.pt
VOCAB_SIZE=2084
BLOCK_SIZE=512
EMBED_DIM=384
NUM_LAYERS=6
NUM_HEADS=6
NUM_KV_HEADS=2
DROPOUT=0.10
BIAS=false
ROPE_FREQ_BASE=10000.0

# Generation & Sampling
TEMPERATURE=0.65
TOP_K=40
TOP_P=0.88
REPETITION_PENALTY=1.12
MAX_NEW_TOKENS=384

# Hybrid RAG Configuration
RAG_TOP_K=4
RAG_CONFIDENCE_THRESHOLD=0.25
RAG_BM25_K1=1.5
RAG_BM25_B=0.75
RAG_FUSION_BM25_WEIGHT=0.60
RAG_FUSION_TFIDF_WEIGHT=0.40

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=genkit_user
MYSQL_PASSWORD=genkit_password
MYSQL_DATABASE=genkit_ai
MYSQL_MIN_POOL_SIZE=2
MYSQL_MAX_POOL_SIZE=10

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MAX_PROMPT_LENGTH=2000
