# ==============================================================================
# GENKIT AI v6.0 ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Security
SECRET_KEY=genkit-enterprise-secret-key-v6-2026
RATE_LIMIT_PER_MINUTE=60
MAX_PROMPT_LENGTH=2000

# Hardware & Training Target: RTX 3050 6GB VRAM, 16GB RAM, Intel i5
DEVICE=cuda
USE_AMP=true
BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=8
BLOCK_SIZE=512
VOCAB_SIZE=10000
EMBED_DIM=384
NUM_LAYERS=6
NUM_HEADS=6
NUM_KV_HEADS=2
EPOCHS=60
LEARNING_RATE=0.0003

# Database (MySQL with SQLite genkit.db local fallback)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=genkit
