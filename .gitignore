# ============================================================
# GENKIT AI v5.0 Enterprise — Master Git Ignore Rules
# ============================================================

# ============================================================
# Python & PyTorch Artifacts
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.coverage.*
*.egg-info/
.ipynb_checkpoints/

# ============================================================
# Virtual Environments
# ============================================================
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# ============================================================
# Environment Variables & Secrets
# ============================================================
.env
.env.*
backend/.env
frontend/.env
!.env.example
!backend/.env.example

# ============================================================
# Model Checkpoints & Large Weights (.pt, .bin, .safetensors)
# (Vocab and config JSON files are tracked)
# ============================================================
*.pt
*.pth
*.ckpt
*.bin
*.joblib
*.pkl
*.onnx
*.safetensors
*.h5
*.keras
backend/checkpoints/*.pt
backend/checkpoints/*.pth
backend/checkpoints/*.bin
backend/checkpoints/*.safetensors
checkpoints/

# ============================================================
# Logs, Caches & Diagnostics
# ============================================================
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Cache, Temp & User Uploads
# ============================================================
cache/
.cache/
backend/cache/
temp/
tmp/
backend/temp/
uploads/
backend/uploads/

# ============================================================
# Node.js & Frontend Artifacts
# ============================================================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.vite/
frontend/.vite/

# ============================================================
# Databases & Dumps
# ============================================================
*.db
*.sqlite
*.sqlite3
*.sql.bak
*.dump

# ============================================================
# IDEs, OS & System Files
# ============================================================
.vscode/
.idea/
.history/
.DS_Store
Thumbs.db
Desktop.ini
*~
.gemini/
.agents/

# ============================================================
# Tracked Configuration Whitelist
# ============================================================
!.gitignore
!README.md
!.env.example
!backend/.env.example